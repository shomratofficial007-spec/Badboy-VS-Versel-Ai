{
  "expo": {
    "name": "Badboy AI",
    "slug": "badboy-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "badboyai",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#030814",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.badboyai.assistant",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Use your microphone when you choose to send a voice message."
      }
    },
    "android": {
      "package": "com.badboyai.assistant",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#030814"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Use your microphone when you choose to send a voice message.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Use your microphone when you choose to send a voice message.",
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}