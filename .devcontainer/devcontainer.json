{
  "name": "Badboy AI Development",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.8.1 --activate && pnpm install --frozen-lockfile",
  "forwardPorts": [8081, 8787],
  "portsAttributes": {
    "8081": {
      "label": "Expo / Metro",
      "onAutoForward": "notify"
    },
    "8787": {
      "label": "Cloudflare Worker local development",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
