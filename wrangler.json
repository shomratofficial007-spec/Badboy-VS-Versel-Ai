{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badboy-vs-versel-ai",
  "main": "functions/api/[[path]].ts",
  "assets": {
    "directory": "./artifacts/mobile/dist",
    "binding": "ASSETS"
  },
  "build": {
    "command": "corepack enable && pnpm run build"
  },
  "compatibility_date": "2025-02-16",
  "compatibility_flags": ["nodejs_compat"],
  "previews": {}
}
