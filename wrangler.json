{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badboy-vs-versel-ai",
  "main": "functions/api/[[path]].ts",
  "assets": {
    "directory": "./artifacts/mobile/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/assistant/*",
      "/health",
      "/healthz"
    ],
    "not_found_handling": "single-page-application"
  },
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "previews": {},
  "workers_dev": true,
  "preview_urls": true
}
