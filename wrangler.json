{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badboy-vs-versel-ai",
  "main": "functions/api/[[path]].ts",
  "assets": {
    "directory": "./artifacts/mobile/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/assistant/*",
      "/health",
      "/healthz"
    ],
    "not_found_handling": "single-page-application"
  },
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "AGENT_DB",
      "database_name": "badboy-agent-db",
      "database_id": "be5648fd-cbb2-487c-8d99-6a0f8c72cf46",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {},
  "workers_dev": true,
  "preview_urls": true
}
