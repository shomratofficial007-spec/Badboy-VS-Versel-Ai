# Backend-only environment variables. Set real values in your hosting provider's
# private environment-variable settings; do not commit a real .env file.
NODE_ENV=production
PORT=3000
OPENROUTER_API_KEY=
# Required by all deployed assistant backends (Cloudflare Worker, Netlify, optional Express API).
# Generate a random 43-128 character URL-safe token and store it only as a private host secret.
BADBOY_OWNER_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=
# Optional for frontend builds. For Netlify/static hosting, point API calls to the full Cloudflare Worker API.
EXPO_PUBLIC_DOMAIN=
BASE_PATH=/
